# Clave para firmar y verificar el JWT (obligatoria, mínimo 32 caracteres).
# Generar una con: openssl rand -hex 32
JWT_SECRET=

# Duración del token.
JWT_EXPIRES_IN=24h

# true usa clientes falsos; false usa clientes HTTP hacia los MS.
USE_MOCKS=true

# Obligatorias si USE_MOCKS=false. El puerto del MS transaccional aún no está definido en docker-compose.yml.
MS_TRANSACCIONAL_URL=
MS_CATALOGO_URL=http://ms-catalogo:8000

PORT=4000
CORS_ORIGIN=http://localhost:5173
