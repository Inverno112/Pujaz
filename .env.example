# Pujaz | KAN-37 | Plantilla de configuración local
# Copiar a .env y completar los secretos antes de iniciar los servicios.
# No subir .env al repositorio ni exponer secretos en el frontend.
# Esta plantilla documenta la configuración: no carga variables por sí sola.
# El Compose actual tiene valores fijos; los puertos y DB_* requieren integración
# explícita en Compose o en cada servicio para modificar su comportamiento.

# Entorno de ejecución: development, test o production.
NODE_ENV=development
# Puerto del proceso Gateway; mantener igual a API_GATEWAY_PORT.
PORT=4000

# Puertos locales por componente. Nginx y MS transaccional son propuestas
# hasta que se implementen sus servidores/configuraciones de despliegue.
NGINX_PORT=8080
SPA_PORT=5173
API_GATEWAY_PORT=4000
MS_TRANSACCIONAL_PORT=3001
MS_CATALOGO_PORT=8000

# PostgreSQL: base exclusiva del microservicio transaccional.
# En Docker usar postgres-db; si el servicio corre en el host usar localhost.
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=pujaz_transaccional
DB_USER=pujaz_user
# Completar y sincronizar con la contraseña configurada en PostgreSQL.
DB_PASSWORD=
# Nombres utilizados por la imagen oficial de PostgreSQL.
# Mantenerlos iguales a DB_NAME, DB_USER y DB_PASSWORD respectivamente.
POSTGRES_DB=pujaz_transaccional
POSTGRES_USER=pujaz_user
POSTGRES_PASSWORD=

# MongoDB: base exclusiva del catálogo. La instancia local actual no usa auth.
# Si el catálogo corre en el host, cambiar mongo-db por localhost en MONGO_URI.
MONGO_URI=mongodb://mongo-db:27017
MONGO_DB_NAME=pujaz_catalogo
MONGO_PORT=27017

# Seguridad del Gateway: obligatorio, secreto aleatorio de al menos 32 caracteres.
# Generar, por ejemplo, con: openssl rand -hex 32
# Solo para el backend; nunca usar prefijos públicos del frontend para secretos.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Gateway: true permite desarrollo con clientes simulados.
# Con false, ambas URLs de microservicios son obligatorias.
# URLs internas de Docker; usar localhost si el Gateway corre en el host.
# El puerto 3001 del servicio transaccional es provisional.
USE_MOCKS=true
MS_TRANSACCIONAL_URL=http://ms-transaccional:3001
MS_CATALOGO_URL=http://ms-catalogo:8000
CORS_ORIGIN=http://localhost:5173

# URLs públicas de desarrollo para GraphQL y suscripciones WebSocket.
# La SPA usa /graphql en su propio origen y Vite lo redirige al Gateway.
# Estas variables documentan esa conexión; aún no son leídas por la SPA.
# Al publicar con Nginx, ajustar al dominio público y usar https/wss con TLS.
GRAPHQL_URL=http://localhost:5173/graphql
WS_URL=ws://localhost:5173/graphql
